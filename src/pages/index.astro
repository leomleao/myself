    let htlIndex = 0;
    let htlPlaying = false;
    let htlPlayInterval = null;

    function htlCardHTML(item) {
      return `
        <span class="htl-card-period">${item.period}</span>
        <h3 class="htl-card-title">${item.title}</h3>
        <p class="htl-card-org">${item.org}</p>
        <ul class="htl-statements">
          ${item.statements.map(s => `
            <li class="htl-statement">
              <span class="htl-brief">${s.brief}</span>
              <span class="htl-detail-wrap"><span class="htl-detail">${s.detail}</span></span>
            </li>`).join('')}
        </ul>
        <button class="htl-expand-btn" aria-expanded="false">
          <span class="htl-expand-label">${copy[lang].htlShowMore}</span>
          <svg class="htl-expand-chevron" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>`;
    }

    function htlActivate(idx, items) {
      htlIndex = idx;

      document.querySelectorAll('.htl-item').forEach((el, i) => el.classList.toggle('is-active', i === idx));
      document.querySelectorAll('.htl-dot-btn').forEach((btn, i) => {
        const sel = i === idx;
        btn.setAttribute('aria-selected', sel ? 'true' : 'false');
        btn.setAttribute('tabindex', sel ? '0' : '-1');
        const dotIcon = btn.querySelector('.htl-dot-icon');
        if (dotIcon) dotIcon.style.color = sel ? items[i].color : '';
      });
      const counter = document.querySelector('.htl-counter');
      if (counter) counter.textContent = `${idx + 1} / ${items.length}`;

      const card = document.querySelector('.htl-card');
      if (!card) return;
      const item = items[idx];
      card.classList.add('is-switching');
      card.classList.remove('is-expanded');
      setTimeout(() => {
        card.style.setProperty('--htl-color', item.color);
        card.innerHTML = htlCardHTML(item);
        requestAnimationFrame(() => card.classList.remove('is-switching'));
      }, 200);
    }

    function htlNavigate(idx, items) {
      if (idx < 0 || idx >= items.length) return;
      const itemEls = document.querySelectorAll('.htl-item');
      if (itemEls[idx]) itemEls[idx].scrollIntoView({ inline: 'center', behavior: 'smooth', block: 'nearest' });
      htlActivate(idx, items);
    }

    function htlUpdatePlayBtn() {
      const btn = document.querySelector('.htl-play-btn');
      if (!btn) return;
      btn.classList.toggle('is-active', htlPlaying);
      btn.setAttribute('aria-pressed', String(htlPlaying));
      const pi = btn.querySelector('.htl-play-icon');
      const pa = btn.querySelector('.htl-pause-icon');
      if (pi) pi.style.display = htlPlaying ? 'none' : '';
      if (pa) pa.style.display = htlPlaying ? '' : 'none';
    }

    function htlStopPlay() {
      clearInterval(htlPlayInterval);
      htlPlayInterval = null;
      htlPlaying = false;
      htlUpdatePlayBtn();
    }

    function htlStartPlay(items) {
      htlStopPlay();
      htlPlaying = true;
      htlUpdatePlayBtn();
      htlPlayInterval = setInterval(() => htlNavigate((htlIndex + 1) % items.length, items), 4000);
    }

    function htlExpand(card) {
      const isExp = card.classList.contains('is-expanded');
      const btn   = card.querySelector('.htl-expand-btn');
      const label = card.querySelector('.htl-expand-label');
      card.classList.toggle('is-expanded', !isExp);
      if (btn) btn.setAttribute('aria-expanded', String(!isExp));
      if (label) label.textContent = isExp ? copy[lang].htlShowMore : copy[lang].htlShowLess;
    }

    // ── Theme ─────────────────────────────────────────────────────────────────
    const themeBtn  = document.getElementById('theme-btn');
    const sunIcon   = document.getElementById('sun-icon');
    const moonIcon  = document.getElementById('moon-icon');

    function applyTheme() {
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      sunIcon.style.display  = dark ? '' : 'none';
      moonIcon.style.display = dark ? 'none' : '';
      themeBtn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
      const canvas = document.querySelector('.plum-canvas');
      if (canvas) canvas.style.filter = dark ? '' : 'invert(1)';
    }

    themeBtn.addEventListener('click', () => {
      dark = !dark;
      localStorage.setItem('theme', dark ? 'dark' : 'light');
      applyTheme();
    });

