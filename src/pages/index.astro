              <span class="htl-counter">1 / ${items.length}</span>
            </div>
            <div class="htl-dots" role="tablist" aria-label="${t.experienceTitle}">
              ${items.map((item, i) => `
                <button class="htl-dot-btn" role="tab" data-index="${i}"
                  aria-selected="${i === 0 ? 'true' : 'false'}"
                  aria-label="${item.year}" tabindex="${i === 0 ? '0' : '-1'}">
                  <span class="htl-dot-icon" style="${i === 0 ? `color:${item.color}` : ''}">${htlIconSVG(item.icon, 13)}</span>
                </button>`).join('')}
            </div>
          </div>
          <div class="htl-scroll">
            <div class="htl-track">
              <div class="htl-ruler"></div>
              ${items.map((item, i) => `
                <div class="htl-item${i === 0 ? ' is-active' : ''}" data-index="${i}" style="--htl-color:${item.color}">
                  <span class="htl-year">${item.year}</span>
                  <div class="htl-stem"></div>
                  <div class="htl-node">${htlIconSVG(item.icon, 15)}</div>
                  <div class="htl-connector"></div>
                  ${i < items.length - 1 ? `<div class="htl-ticks">
                    <div class="htl-tick" style="left:25%"></div>
                    <div class="htl-tick" style="left:50%"></div>
                    <div class="htl-tick" style="left:75%"></div>
                  </div>` : ''}
                </div>`).join('')}
              ${t.htlEvents.map(ev => `
                <div class="htl-event htl-event--${ev.above ? 'above' : 'below'}" data-cx="${ev.cx}">
                  <div class="htl-event-stem"></div>
                  <div class="htl-event-dot"></div>
                  <span class="htl-event-label"><em>${ev.date}</em>${ev.label}</span>
                </div>`).join('')}
            </div>
          </div>
          <div class="htl-card" style="--htl-color:${items[0].color}"></div>
        </div>`;
      htlActivate(0, items);
      requestAnimationFrame(htlPositionEvents);

      // Services
      document.querySelector('.service-grid').innerHTML = t.services
        .map(svc => `
          <article>
            <h3>${svc.title}</h3>
            <p>${svc.body}</p>
            <ul class="service-card-points">${svc.points.map(p => `<li>${p}</li>`).join('')}</ul>
            <span class="service-card-tag">${svc.tag}</span>
          </article>`)
        .join('');

      // Skills — tag groups
      document.querySelector('.skills').innerHTML = t.skills
        .map(group => `
          <div class="skill-group">
            <p class="skill-group-label">${group.group}</p>
            <div class="skill-tags">${group.tags.map(tag => {
              const proof = skillProofs[tag] || '';
              const attr  = proof ? ` data-proof="${proof.replace(/"/g, '&quot;')}"` : '';
              return `<span class="skill-tag"${attr}>${tag}</span>`;
            }).join('')}</div>
          </div>`)
        .join('');

      // Placeholder translations
      document.querySelectorAll('[data-i18n-ph]').forEach(el => {
        const key = el.dataset.i18nPh;
        if (typeof t[key] === 'string') el.placeholder = t[key];
      });

      // Lang button
      langFlag.src = lang === 'en' ? '/img/brazilFlag.png' : '/img/usFlag.png';
      langLabel.textContent = lang === 'en' ? 'PT' : 'EN';
    }

    // ── Lang morph ───────────────────────────────────────────────────────────
    const MORPH_OUT_MS = 185;

    function morphTextEls() {
      // Only pure-text nodes: no buttons (have bg), no inputs, no textareas
      return [...document.querySelectorAll('[data-i18n]')].filter(el =>
        !el.classList.contains('button') &&
        el.tagName !== 'INPUT' &&
        el.tagName !== 'TEXTAREA'
      );
    }

    function morphLang(callback) {
      langBtn.disabled = true;

      morphTextEls().forEach(el => {
        el.classList.remove('lang-morph-in');
        el.classList.add('lang-morph-out');
      });

      setTimeout(() => {
        callback();

        // Re-query after applyLang rebuilds DOM
        morphTextEls().forEach(el => {
          el.classList.remove('lang-morph-out');
          el.classList.add('lang-morph-in');
        });

        setTimeout(() => {
          morphTextEls().forEach(el => el.classList.remove('lang-morph-in'));
          langBtn.disabled = false;
        }, 270);

      }, MORPH_OUT_MS);
    }

    langBtn.addEventListener('click', () => {
      lang = lang === 'en' ? 'pt' : 'en';
      morphLang(applyLang);
    });

    // ── Timeline carousel events ──────────────────────────────────────────────
    document.querySelector('.timeline').addEventListener('click', e => {
      const items = copy[lang].experience;
      if (e.target.closest('.htl-prev-btn')) {
        htlStopPlay();
        htlNavigate((htlIndex - 1 + items.length) % items.length, items);
        return;
      }
      if (e.target.closest('.htl-next-btn')) {
        htlStopPlay();
        htlNavigate((htlIndex + 1) % items.length, items);
        return;
      }
      if (e.target.closest('.htl-play-btn')) {
        htlPlaying ? htlStopPlay() : htlStartPlay(items);
        return;
      }
      const dotBtn = e.target.closest('.htl-dot-btn');
      if (dotBtn) {
        htlStopPlay();
        htlNavigate(parseInt(dotBtn.dataset.index), items);
        return;
      }
      if (e.target.closest('.htl-expand-btn') || e.target.closest('.htl-brief')) {
        const card = document.querySelector('.htl-card');
        if (card) htlExpand(card);
        return;
      }
      const itemEl = e.target.closest('.htl-item');
      if (itemEl) htlNavigate(parseInt(itemEl.dataset.index), items);
    });

    // ── Footer year ───────────────────────────────────────────────────────────
    document.getElementById('year').textContent = new Date().getFullYear();
    window.addEventListener('resize', htlPositionEvents);

    // ── Plum canvas ───────────────────────────────────────────────────────────
    let plumRunning = false;
    let plumRaf = 0;

    function runPlum() {
      const canvas = document.querySelector('.plum-canvas');
      if (!canvas) return;

      const ctx  = canvas.getContext('2d');
      const dpr  = window.devicePixelRatio || 1;
      let W, H;

      function setup() {
        W = window.innerWidth;
        H = window.innerHeight;
        canvas.width  = W * dpr;
        canvas.height = H * dpr;
        canvas.style.width  = W + 'px';
        canvas.style.height = H + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.lineWidth   = 1;
        ctx.strokeStyle = '#ffffff18';
      }

      const SPREAD   = Math.PI / 6;
      const FRAME_MS = 25;

      let qCur = [], qNext = [], lastTime = 0;

      function branch(x, y, angle, counter) {
        counter.n++;
        const len = 6 * Math.random();
        const x2  = x + len * Math.cos(angle);
        const y2  = y + len * Math.sin(angle);
        ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x2, y2); ctx.stroke();
        if (x2 < -100 || x2 > W + 100 || y2 < -100 || y2 > H + 100) return;
        const prob = counter.n <= 30 ? 0.8 : 0.5;
        if (Math.random() < prob) qNext.push(() => branch(x2, y2, angle + Math.random() * SPREAD, counter));
        if (Math.random() < prob) qNext.push(() => branch(x2, y2, angle - Math.random() * SPREAD, counter));
      }

      function rnd() { return Math.random() * 0.6 + 0.2; }

      function start() {
        ctx.clearRect(0, 0, W, H);
        qCur  = [];
        qNext = [
          () => branch(rnd() * W, -5,     Math.PI / 2,  { n: 0 }),
          () => branch(rnd() * W, H + 5, -Math.PI / 2,  { n: 0 }),
          () => branch(-5,     rnd() * H, 0,             { n: 0 }),
          () => branch(W + 5,  rnd() * H, Math.PI,       { n: 0 }),
        ];
        if (W < 500) qNext = qNext.slice(0, 2);
        plumRunning = true;
        lastTime    = 0;
        plumRaf     = requestAnimationFrame(frame);
      }

      function frame(now) {
        if (!plumRunning) return;
        plumRaf = requestAnimationFrame(frame);
        if (now - lastTime < FRAME_MS) return;
        lastTime = now;
        qCur  = qNext;
        qNext = [];
        if (!qCur.length) { plumRunning = false; return; }
        qCur.forEach(fn => Math.random() < 0.5 ? qNext.push(fn) : fn());
      }

      setup();
      start();

      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          plumRunning = false;
          cancelAnimationFrame(plumRaf);
          setup();
          start();
        }, 200);
      });
    }

    // ── Contact form ──────────────────────────────────────────────────────────
    document.getElementById('contact-form').addEventListener('submit', async e => {
      e.preventDefault();
      const form    = e.target;
      const btn     = form.querySelector('button[type="submit"]');
      const status  = document.getElementById('cf-status');
      const name    = document.getElementById('cf-name').value.trim();
      const email   = document.getElementById('cf-email').value.trim();
      const message = document.getElementById('cf-msg').value.trim();

      btn.disabled = true;
      status.textContent = '';
      status.className = 'cf-status';

      try {
        const res = await fetch('https://formspree.io/f/xqenylgy', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ name, email, message }),
        });
        const data = await res.json();
        if (res.ok && data.ok) {
          status.textContent = copy[lang].cfSent;
          status.className = 'cf-status ok';
          form.reset();
        } else {
          status.textContent = copy[lang].cfErr;
          status.className = 'cf-status err';
        }
      } catch {
        status.textContent = copy[lang].cfErr;
        status.className = 'cf-status err';
      } finally {
        btn.disabled = false;
      }
    });

    // ── Init ──────────────────────────────────────────────────────────────────
    applyTheme();
    applyLang();
    runPlum();

    // ── Skill tooltip ─────────────────────────────────────────────────────────
    const tip     = document.getElementById('skill-tip');
    const tipName = document.getElementById('skill-tip-name');
    const tipBody = document.getElementById('skill-tip-body');

    function positionTip(tagEl) {
      const rect    = tagEl.getBoundingClientRect();
      const tipW    = tip.offsetWidth  || 280;
      const tipH    = tip.offsetHeight || 80;
      const gap     = 10;
      let top  = rect.top - tipH - gap;
      if (top < 8) top = rect.bottom + gap;
      let left = rect.left + rect.width / 2 - tipW / 2;
      left = Math.max(8, Math.min(left, window.innerWidth - tipW - 8));
      tip.style.top  = top  + 'px';
      tip.style.left = left + 'px';
    }

    const skillsEl = document.querySelector('.skills');
    skillsEl.addEventListener('mouseover', e => {
      const tagEl = e.target.closest('.skill-tag');
      if (!tagEl || !tagEl.dataset.proof) return;
      tipName.textContent = tagEl.textContent;
      tipBody.textContent = tagEl.dataset.proof;
      tip.setAttribute('aria-hidden', 'false');
      tip.classList.add('visible');
      positionTip(tagEl);
    });
    skillsEl.addEventListener('mouseover', e => {
      if (!e.target.closest('.skill-tag')) {
        tip.classList.remove('visible');
        tip.setAttribute('aria-hidden', 'true');
      }
    });
    skillsEl.addEventListener('mouseleave', () => {
      tip.classList.remove('visible');
      tip.setAttribute('aria-hidden', 'true');
    });
  </script>

</body>
</html>
