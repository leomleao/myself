      <p class="profile-eyebrow" data-i18n="eyebrow">SAP AMS Consultant · Developer · AI Engineer</p>
      <p class="profile-subtitle" data-i18n="subtitle">Where enterprise process meets production engineering — amplified by AI.</p>
      <p class="profile-location" data-i18n="location">Edinburgh, Scotland</p>
      <div class="actions">
        <a class="button primary" href="#experience" data-i18n="ctaPrimary">View experience</a>
        <a class="button secondary" href="#contact" data-i18n="ctaSecondary">Get in touch</a>
      </div>
      <nav class="profile-nav" aria-label="Main navigation">
        <a href="#about"      data-i18n="nav0">About</a>
        <a href="#services"   data-i18n="nav1">Services</a>
        <a href="#experience" data-i18n="nav2">Experience</a>
        <a href="#skills"     data-i18n="nav3">Skills</a>
        <a href="#contact"    data-i18n="nav4">Contact</a>
      </nav>
    </section>

    <!-- ── About ── -->
    <section id="about" class="section two-column">
      <div>
        <p class="section-label">01</p>
        <h2 data-i18n="aboutTitle">About</h2>
        <p class="about-lead" data-i18n="aboutLead"></p>
        <p data-i18n="aboutBody"></p>
      </div>
      <div class="portrait-wrap">
        <img src="/img/leo-profile.jpg" alt="Leonardo Leão" />
      </div>
    </section>

    <section class="facts" aria-label="Quick facts">
      <!-- rendered by JS -->
    </section>

    <!-- ── Services ── -->
    <section id="services" class="section muted">
      <p class="section-label">02</p>
      <h2 data-i18n="servicesTitle">Services</h2>
      <div class="service-grid">
        <!-- rendered by JS -->
      </div>
    </section>

    <!-- ── Experience ── -->
    <section id="experience" class="section">
      <p class="section-label">03</p>
      <h2 data-i18n="experienceTitle">Experience</h2>
      <div class="timeline">
        <!-- rendered by JS -->
      </div>
    </section>

    <!-- ── Skills ── -->
    <section id="skills" class="section">
      <p class="section-label">04</p>
      <h2 data-i18n="skillsTitle">Skills</h2>
      <div class="skills">
        <!-- rendered by JS -->
      </div>
    </section>

    <!-- ── Contact ── -->
    <section id="contact" class="section muted">
      <p class="section-label">05</p>
      <h2 data-i18n="contactTitle">Contact</h2>
      <p data-i18n="contactBody">Open to SAP consulting, AI engineering, advisory and fractional roles. Based in Edinburgh, available remotely worldwide.</p>
      <form id="contact-form" novalidate>
        <div class="form-row">
          <input type="text"  id="cf-name"  data-i18n-ph="cfName"  placeholder="Your name"  required autocomplete="name" />
          <input type="email" id="cf-email" data-i18n-ph="cfEmail" placeholder="Your email" required autocomplete="email" />
        </div>
        <textarea id="cf-msg" data-i18n-ph="cfMsg" rows="5" placeholder="Your message" required></textarea>
        <div class="form-footer">
          <button type="submit" class="button primary">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            <span data-i18n="cfSubmit">Send message</span>
          </button>
          <p id="cf-status" class="cf-status" aria-live="polite"></p>
        </div>
      </form>
    </section>

  </main>

