      // Skills — tag groups
      document.querySelector('.skills').innerHTML = t.skills
        .map(group => `
          <div class="skill-group">
            <p class="skill-group-label">${group.group}</p>
            <div class="skill-tags">${group.tags.map(tag => {
              const proof = skillProofs[tag] || '';
              const attr  = proof ? ` data-proof="${proof.replace(/"/g, '&quot;')}"` : '';
              return `<span class="skill-tag"${attr}>${tag}</span>`;
            }).join('')}</div>
          </div>`)
