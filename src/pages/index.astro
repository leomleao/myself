          ['HTML / CSS', 80],
          ['JavaScript', 65],
          ['React', 60],
          ['Java', 50],
        ],
        contactTitle: 'Contato',
        contactBody: 'Disponivel para projetos remotos de web e TI. Entre em contato.',
        footerRights: 'Todos os direitos reservados.',
      },
    };

    // ── State ─────────────────────────────────────────────────────────────────
    let lang = 'en';
    let dark = localStorage.getItem('theme') !== 'light';

    // ── Theme ─────────────────────────────────────────────────────────────────
    const themeBtn  = document.getElementById('theme-btn');
    const sunIcon   = document.getElementById('sun-icon');
    const moonIcon  = document.getElementById('moon-icon');

    function applyTheme() {
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      sunIcon.style.display  = dark ? '' : 'none';
      moonIcon.style.display = dark ? 'none' : '';
      themeBtn.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
    }

    themeBtn.addEventListener('click', () => {
      dark = !dark;
      localStorage.setItem('theme', dark ? 'dark' : 'light');
      applyTheme();
      restartPlum();
    });

    // ── Language ──────────────────────────────────────────────────────────────
    const langBtn   = document.getElementById('lang-btn');
    const langFlag  = document.getElementById('lang-flag');
    const langLabel = document.getElementById('lang-label');

    function applyLang() {
      const t = copy[lang];
      document.documentElement.lang = lang;

      // Simple key swaps
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.dataset.i18n;
        if (typeof t[key] === 'string') el.textContent = t[key];
      });

      // Facts
      document.querySelector('.facts').innerHTML = t.facts
        .map(([val, label]) => `<div><strong>${val}</strong><span>${label}</span></div>`)
        .join('');

      // Timeline
      document.querySelector('.timeline').innerHTML = t.experience
        .map(item => `
          <article class="timeline-item">
            <time>${item.period}</time>
            <div>
              <h3>${item.title}</h3>
              <p class="org">${item.org}</p>
              <ul>${item.points.map(p => `<li>${p}</li>`).join('')}</ul>
            </div>
          </article>`)
        .join('');

      // Services
      document.querySelector('.service-grid').innerHTML = t.services
        .map(([title, body]) => `<article><h3>${title}</h3><p>${body}</p></article>`)
        .join('');

      // Skills
      document.querySelector('.skills').innerHTML = t.skills
        .map(([skill, value]) => `
          <div class="skill">
            <div><span>${skill}</span><strong>${value}%</strong></div>
            <meter min="0" max="100" value="${value}">${value}%</meter>
          </div>`)
        .join('');

      // Lang button
      langFlag.src = lang === 'en' ? '/img/brazilFlag.png' : '/img/usFlag.png';
      langLabel.textContent = lang === 'en' ? 'PT' : 'EN';
    }

    langBtn.addEventListener('click', () => {
      lang = lang === 'en' ? 'pt' : 'en';
      applyLang();
    });

    // ── Footer year ───────────────────────────────────────────────────────────
    document.getElementById('year').textContent = new Date().getFullYear();

    // ── Plum canvas ───────────────────────────────────────────────────────────
    let plumRunning = false;
    let plumRaf = 0;

    function restartPlum() {
      plumRunning = false;
      cancelAnimationFrame(plumRaf);
      runPlum();
    }

    function runPlum() {
      const canvas = document.querySelector('.plum-canvas');
      if (!canvas) return;

      const ctx  = canvas.getContext('2d');
      const dpr  = window.devicePixelRatio || 1;
      let W, H;

      function setup() {
        W = window.innerWidth;
        H = window.innerHeight;
        canvas.width  = W * dpr;
        canvas.height = H * dpr;
        canvas.style.width  = W + 'px';
        canvas.style.height = H + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.lineWidth   = 1;
        ctx.strokeStyle = document.documentElement.dataset.theme === 'dark' ? '#ffffff18' : '#88888825';
      }

      const SPREAD   = Math.PI / 6;
      const FRAME_MS = 25;

      let qCur = [], qNext = [], lastTime = 0;

      function branch(x, y, angle, counter) {
        counter.n++;
        const len = 6 * Math.random();
        const x2  = x + len * Math.cos(angle);
        const y2  = y + len * Math.sin(angle);
        ctx.beginPath(); ctx.moveTo(x, y); ctx.lineTo(x2, y2); ctx.stroke();
        if (x2 < -100 || x2 > W + 100 || y2 < -100 || y2 > H + 100) return;
        const prob = counter.n <= 30 ? 0.8 : 0.5;
        if (Math.random() < prob) qNext.push(() => branch(x2, y2, angle + Math.random() * SPREAD, counter));
        if (Math.random() < prob) qNext.push(() => branch(x2, y2, angle - Math.random() * SPREAD, counter));
      }

      function rnd() { return Math.random() * 0.6 + 0.2; }

      function start() {
        ctx.clearRect(0, 0, W, H);
        qCur  = [];
        qNext = [
          () => branch(rnd() * W, -5,     Math.PI / 2,  { n: 0 }),
          () => branch(rnd() * W, H + 5, -Math.PI / 2,  { n: 0 }),
          () => branch(-5,     rnd() * H, 0,             { n: 0 }),
          () => branch(W + 5,  rnd() * H, Math.PI,       { n: 0 }),
        ];
        if (W < 500) qNext = qNext.slice(0, 2);
        plumRunning = true;
        lastTime    = 0;
        plumRaf     = requestAnimationFrame(frame);
      }

      function frame(now) {
        if (!plumRunning) return;
        plumRaf = requestAnimationFrame(frame);
        if (now - lastTime < FRAME_MS) return;
        lastTime = now;
        qCur  = qNext;
        qNext = [];
        if (!qCur.length) { plumRunning = false; return; }
        qCur.forEach(fn => Math.random() < 0.5 ? qNext.push(fn) : fn());
      }

      setup();
      start();

      let resizeTimer;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
          plumRunning = false;
          cancelAnimationFrame(plumRaf);
          setup();
          start();
        }, 200);
      });
    }

    // ── Init ──────────────────────────────────────────────────────────────────
    applyTheme();
    applyLang();
    runPlum();
  </script>

</body>
</html>
