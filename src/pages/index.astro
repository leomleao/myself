        services: [
          ['Web Design', 'Sites responsivos e interfaces visuais bem cuidadas.'],
          ['Desenvolvimento', 'Implementacao front-end pratica e codigo de UI facil de manter.'],
        ],
        skillsTitle: 'Skills',
