    // ── HTL event markers — cx values assume 200px item width ────────────────
    // Now@100, 2024@300, 2019@500, 2015@700, 2014@900, 2011@1100, 2003@1300

    function htlPositionEvents() {
      const scroll = document.querySelector('.htl-scroll');
      const first  = document.querySelector('.htl-item');
      if (!scroll || !first) return;
      const itemW = first.offsetWidth;
      const pad   = scroll.clientWidth / 2 - itemW / 2;
      document.querySelectorAll('.htl-event').forEach(el => {
        el.style.left = (pad + parseFloat(el.dataset.cx) * itemW / 200) + 'px';
      });
    }

