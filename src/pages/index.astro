        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
    <button id="lang-btn" class="language" type="button">
      <img id="lang-flag" src="/img/brazilFlag.png" alt="" width="22" height="22" />
