              <h3>${item.title}</h3>
              <p class="org">${item.org}</p>
              <ul>${item.points.map(p => `<li>${p}</li>`).join('')}</ul>
              ${item.tags ? `<div class="tl-chips">${item.tags.map(tag => `<span class="tl-chip">${tag}</span>`).join('')}</div>` : ''}
            </div>
          </article>`)
        .join('');

      // Services
      document.querySelector('.service-grid').innerHTML = t.services
        .map(svc => `
